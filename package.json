{
  "name": "chatdidit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test server/*.test.ts",
    "start": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "loadtest": "node --import tsx --env-file-if-exists=.env scripts/loadtest.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "test:extension": "node --import tsx scripts/extension-smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/tasks": "^7.3.1",
    "fastify": "^5.6.1",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
